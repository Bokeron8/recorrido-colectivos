{
  "cli": {
    "version": ">= 16.30.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "MAPBOX_PUBLIC_TOKEN": "${MAPBOX_PUBLIC_TOKEN}"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "MAPBOX_PUBLIC_TOKEN": "${MAPBOX_PUBLIC_TOKEN}"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "env": {
        "MAPBOX_PUBLIC_TOKEN": "${MAPBOX_PUBLIC_TOKEN}"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
